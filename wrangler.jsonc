{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yahyacompany",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["* * * * *"] }
}
